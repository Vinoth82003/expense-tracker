generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id           String     @id @default(auto()) @map("_id") @db.ObjectId
  name         String?
  email        String     @unique
  avatar       String?
  authProvider String?
  password     String?
  monthlyLimit Float?
  expenseMode  String?    // "limit" or "no-limit"
  onboarded    Boolean    @default(false)
  isAdmin      Boolean    @default(false)
  adminRole    String?    @default("SUPER") // "SUPER" or "READONLY"

  twoFactorEnabled    Boolean   @default(false)
  twoFactorOTP        String?
  twoFactorOTPExpires DateTime?
  
  isPWAInstalled   Boolean    @default(false)

  expenses     Expense[]
  categories   Category[]
  incomes      Income[]
  reports      Report[]
  aiUsageLogs  AiUsageLog[]
  budgets      Budget[]
  pageViews    PageView[]
  categoryPreferences UserCategoryPreference[]

  streak       Int        @default(0)
  lastActive   DateTime?  @default(now())

  isSuspended      Boolean   @default(false)
  suspensionReason String?

  sessions      UserSession[]
  otpLogs       OTPLog[]
  loginHistory  LoginHistory[]

  isLocked         Boolean   @default(false)
  lockedAt         DateTime?
  lockReason       String?

  unsubscribes     Unsubscribe[]
  securityAlerts   SecurityAlert[]

  readNotificationIds     String[]  @default([])
  deletedNotificationIds  String[]  @default([])

  lastBudgetAlertMonth String?  // "YYYY-MM" format

  reviews          Review[]
  
  createdGroups     Group[]        @relation("GroupCreator")
  groupMemberships  GroupMember[]
  paidGroupExpenses GroupExpense[] @relation("ExpensePayer")
  expenseSplits     ExpenseSplit[]
  authTickets       AuthTicket[]

  createdAt        DateTime?   @default(now())
  updatedAt        DateTime    @updatedAt
}

model Review {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  rating      Int      @default(5)
  comment     String
  status      String   @default("PENDING") // "PENDING", "APPROVED", "REJECTED"
  createdAt   DateTime @default(now())

  userId      String   @db.ObjectId
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SecurityAlert {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  type        String   // "BRUTE_FORCE", "NEW_COUNTRY", "MASS_IMPORT", "AI_ABUSE"
  severity    String   // "CRITICAL", "WARNING"
  description String
  userId      String?  @db.ObjectId
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  status      String   @default("ACTIVE") // "ACTIVE", "DISMISSED"
  createdAt   DateTime @default(now())
}

model BlockedIP {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  ip        String   @unique
  note      String?
  addedBy   String   // Admin name
  requests  Int      @default(0)
  createdAt DateTime @default(now())
}

model AuditLog {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  adminName   String
  adminId     String   @db.ObjectId
  actionType  String   // "USER_SUSPENDED", "USER_DELETED", "2FA_RESET", etc.
  target      String   // user email or resource id
  details     String
  ip          String
  createdAt   DateTime @default(now())
}

model Notification {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  subject        String
  body           String
  bodyFormat     String   @default("text") // "text" | "html"
  recipientCount Int
  recipientFilter String? // JSON stringified filter
  status         String   // "SENT", "FAILED"
  error          String?  // Error message if failed
  adminName      String
  createdAt      DateTime @default(now())
}

model EmailTemplate {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  name       String   @unique
  subject    String
  body       String
  bodyFormat String   @default("text") // "text" | "html"
  isSystem   Boolean  @default(false)
  updatedAt  DateTime @updatedAt
}

model Unsubscribe {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  email     String   @unique
  reason    String?
  createdAt DateTime @default(now())
}

model PageView {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  page      String   // e.g., "Dashboard", "Expenses", etc.
  createdAt DateTime @default(now())

  @@index([page, createdAt])
}

// Anonymous first-party pageviews for the public marketing site
// (thespendwise.vercel.app). No cookies, no PII: sessionId is a random
// per-tab value kept in sessionStorage. Retention is enforced by the
// hourly maintenance cron (rows older than SITE_ANALYTICS_RETENTION_DAYS).
model SitePageView {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  path      String
  referrer  String?
  country   String?   // from x-vercel-ip-country / cf-ipcountry when present
  sessionId String?
  createdAt DateTime @default(now())

  @@index([path, createdAt])
  @@index([createdAt])
}

model UserSession {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  device    String
  browser   String
  ip        String
  location  String?
  expires   DateTime
  createdAt DateTime @default(now())
}

model OTPLog {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String?  @db.ObjectId
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  email     String
  status    String   // "SUCCESS", "FAILED", "EXPIRED"
  ip        String
  userAgent String?
  attempts  Int      @default(1)
  createdAt DateTime @default(now())
  expiresAt DateTime
}

model LoginHistory {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  method    String   
  status    String   
  ip        String
  device    String
  browser   String
  userAgent String?
  createdAt DateTime @default(now())
}

model Report {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  content   String?  // The AI generated report text (JSON stringified)
  status    String   @default("SUCCESS") // "SUCCESS", "FAILED", "PROCESSING"
  tokens    Int?     @default(0)
  cost      Float?   @default(0)
  error     String?
  date      DateTime @default(now())
  
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

model AiUsageLog {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  userId       String   @db.ObjectId
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  callType     String   // "nlu" | "nlg" | "analyze"
  intent       String?  // classified/handled intent label, not message content
  promptTokens Int?
  outputTokens Int?
  costUsd      Float?
  latencyMs    Int?
  fallbackUsed Boolean  @default(false) // true if Groq failed and V3 behavior was used
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
}

model Settings {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  key               String   @unique
  value             String
  updatedAt         DateTime @updatedAt
}

model Budget {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  amount    Float
  month     String   // "YYYY-MM" format
  
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month])
}

model Expense {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  amount        Float
  category      String   // "Needs" or "Wants"
  subcategory   String
  note          String?
  date          DateTime
  attachmentUrl String?

  // Provenance: how this row was entered. Defaults to MANUAL so every row that
  // predates this column keeps a valid value. Set server-side only — never
  // trusted from the request body — so a client cannot forge "By Sage".
  entrySource   String   @default("MANUAL") // "MANUAL" (by you) | "SAGE" (by Sage)

  userId        String   @db.ObjectId
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt     DateTime? @default(now())
}

model Category {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  type      String   // "Needs" or "Wants"
  isDefault Boolean  @default(false)
  icon      String?
  color     String?

  userId    String?  @db.ObjectId
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  hiddenBy  UserCategoryPreference[]
}

model Income {
  id      String   @id @default(auto()) @map("_id") @db.ObjectId
  amount  Float
  source  String
  note    String?
  date    DateTime

  // Provenance: how this row was entered, not what the income is.
  // `source` above already means the income origin (Salary, Freelance, ...).
  entrySource String @default("MANUAL") // "MANUAL" (by you) | "SAGE" (by Sage)

  userId  String   @db.ObjectId
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime? @default(now())
}

/**
 * A user's own "hide this system category" choice. Deliberately per-user:
 * hiding a shared system Category row would hide it for every account, which
 * is not what a settings-page toggle should do.
 */
model UserCategoryPreference {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  userId     String   @db.ObjectId
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId String   @db.ObjectId
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  hidden     Boolean  @default(true)

  createdAt  DateTime @default(now())

  @@unique([userId, categoryId])
}

model FAQ {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  question String
  answer   String
  category String
  order    Int    @default(0)

  updatedAt DateTime @updatedAt
}

model Doc {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  content     String   // Markdown or HTML content
  contentType String   @default("MARKDOWN") // "MARKDOWN" or "HTML"
  status      String   @default("DRAFT") // "DRAFT" or "PUBLISHED"
  category    String
  slug        String   @unique
  order       Int      @default(0)
  helpfulCount    Int      @default(0)
  notHelpfulCount Int      @default(0)
  updatedAt   DateTime? @updatedAt
  createdAt   DateTime? @default(now())
}

model SystemLog {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  level     String   // "INFO", "WARN", "ERROR", "CRITICAL"
  service   String   // "API", "WORKER", "AUTH", etc.
  message   String
  details   String?  // JSON string or long text
  ip        String?
  userId    String?  @db.ObjectId
  createdAt DateTime @default(now())

  @@index([level, createdAt])
  @@index([service, createdAt])
}

model Group {
  id          String         @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  description String?
  createdBy   String         @db.ObjectId
  creator     User           @relation("GroupCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  
  members     GroupMember[]
  expenses    GroupExpense[]
  invitations Invitation[]

  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model GroupMember {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  groupId   String   @db.ObjectId
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  role      String   @default("MEMBER") // "ADMIN", "MEMBER"
  status    String   @default("PENDING") // "PENDING", "ACCEPTED"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, groupId])
}

model GroupExpense {
  id          String         @id @default(auto()) @map("_id") @db.ObjectId
  groupId     String         @db.ObjectId
  group       Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  description String
  amount      Float
  date        DateTime
  paidById    String         @db.ObjectId
  paidBy      User           @relation("ExpensePayer", fields: [paidById], references: [id], onDelete: Cascade)
  status      String         @default("PENDING") // "PENDING", "PARTIAL", "PAID"
  
  splits      ExpenseSplit[]

  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model ExpenseSplit {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  groupExpenseId String       @db.ObjectId
  groupExpense   GroupExpense @relation(fields: [groupExpenseId], references: [id], onDelete: Cascade)
  userId         String       @db.ObjectId
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount         Float
  splitType      String       // "equal", "count", "custom"
  count          Int?

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Invitation {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  groupId   String   @db.ObjectId
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  email     String
  token     String   @unique
  status    String   @default("PENDING") // "PENDING", "ACCEPTED", "DECLINED"
  expiresAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// One-time tickets for the cross-origin auth bridge: a session on the primary
// app origin (Google OAuth) hands a short-lived ticket to a sibling origin,
// which exchanges it (exactly once) for its own local session cookie.
model AuthTicket {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  token     String    @unique
  userId    String    @db.ObjectId
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
}

model EmailLog {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  campaignId String?   @db.ObjectId
  userId     String?   @db.ObjectId
  email      String
  opened     Boolean   @default(false)
  openedAt   DateTime?
  clicked    Boolean   @default(false)
  clickedAt  DateTime?
  sentAt     DateTime  @default(now())
  userAgent  String?
  ip         String?

  @@index([campaignId, opened])
  @@index([email])
}
