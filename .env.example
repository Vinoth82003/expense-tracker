# =============================================================================
# SpendWise Environment Variables — Placeholder Template
# Copy this file to .env and fill in your own values. NEVER commit .env files.
# =============================================================================

# --- NextAuth ---
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-to-a-random-64-char-string

# --- MongoDB / Prisma ---
DATABASE_URL=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/expense-tracker

# --- Google OAuth ---
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# --- SMTP (Gmail) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=your-cloud-name
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your-upload-preset
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# --- AI APIs ---
GEMINI_API_KEY=your-gemini-api-key

# --- Groq (V4 chat brain — default OFF, V3 rule engine stays authoritative) ---
GROQ_CHAT_ENABLED=false
GROQ_API_KEY=your-groq-api-key
GROQ_CHAT_MODEL=llama-3.3-70b-versatile
GROQ_ANALYZE_MODEL=llama-3.3-70b-versatile
# Shadow mode: classify low-confidence messages via Groq but do NOT act on the
# result — log AiUsageLog rows only (used to measure NLU accuracy pre-cutover).
GROQ_NLU_SHADOW=false
# Cost tracking for AiUsageLog (USD per 1K tokens, llama-3.3-70b on Groq).
GROQ_COST_PER_1K_PROMPT=0.00059
GROQ_COST_PER_1K_COMPLETION=0.00079

# --- Redis ---
REDIS_URI=redis://default:<password>@<host>:<port>

# --- Resend ---
RESEND=re_your-resend-api-key

# --- Admin Panel ---
ADMIN_USER=admin@example.com
ADMIN_PASS=your-strong-admin-password
ADMIN_JWT_SECRET=your-admin-jwt-secret
SUPER_ADMIN_USER=superadmin@example.com
SUPER_ADMIN_PASS=your-strong-super-admin-password
ADMIN_RATE_LIMIT_MAX=5
ADMIN_RATE_LIMIT_WINDOW_MS=60000
ADMIN_LOGIN_ALERT_THRESHOLD=5
ADMIN_LOGIN_ALERT_WINDOW_MS=900000

# --- Internal API ---
INTERNAL_API_SECRET=change-me-to-a-random-secret

# --- App Config ---
NEXT_PUBLIC_PRODUCTION_LINK=https://your-production-domain.vercel.app
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com
NEXT_PUBLIC_GA_ID=G-MEASUREMENT_ID
EMAIL=support@example.com
PHONE=+1-234-567-8900
GITHUB=https://github.com/your-org/your-repo
LINKEDIN=https://linkedin.com/in/your-profile
REPO_NAME=expense-tracker
PROJECT_NAME=projects/your-project-id
PROJECT_NUMBER=your-project-number

# --- Multi-origin topology ---
# This app is deployed to several origins from one codebase/database:
#   https://thespendwise.vercel.app                        -> marketing site
#   https://money-spend-tracker.vercel.app                 -> PRIMARY app origin:
#                                                             the only origin registered in Google
#                                                             OAuth console; all sign-ins happen here
#   https://expense-tracker-black-nine-57.vercel.app       -> secondary app instance
# Sign-ins started on any other origin redirect to the primary, then bridge back.
# IMPORTANT: every deployment must share the same NEXTAUTH_SECRET and DATABASE_URL,
# and set its own NEXTAUTH_URL to its own domain.
NEXT_PUBLIC_APP_ORIGIN=https://money-spend-tracker.vercel.app
NEXT_PUBLIC_MARKETING_ORIGIN=https://thespendwise.vercel.app
# Comma-separated extra origins allowed for CORS/CSRF (defaults already include
# the three origins above and http://localhost:3000):
NEXT_PUBLIC_EXTRA_ALLOWED_ORIGINS=

# --- Rate Limiting ---
CHAT_RATE_LIMIT_MAX=20
CHAT_RATE_LIMIT_WINDOW_MS=60000
