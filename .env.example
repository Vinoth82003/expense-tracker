# =============================================================================
# SpendWise Environment Variables — Placeholder Template
# Copy this file to .env and fill in your own values. NEVER commit .env files.
# =============================================================================

# --- NextAuth ---
# NEXTAUTH_URL is the Auth.js callback base ONLY. It is never used to build
# user-facing links (emails, canonicals, sitemap). Do not point it at
# http://localhost:3000 on a production deployment — Auth.js builds its OAuth
# callback URLs from it, so a wrong value breaks Google sign-in outright.
# Use http://localhost:3000 for local dev only.
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-to-a-random-64-char-string

# --- MongoDB / Prisma ---
DATABASE_URL=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/expense-tracker

# --- Google OAuth ---
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# --- SMTP (Gmail) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
# Optional tuning. The defaults shown are the values in lib/mail.ts and
# lib/queue.ts — override only with a reason. Mass sends share ONE pooled,
# transporter: a fresh TCP+TLS+AUTH handshake per email is what makes providers
# throttle a campaign into "Connection timeout".
# SMTP_SECURE=true                 # force TLS on/off (default: on for port 465)
# SMTP_MAX_CONNECTIONS=1           # concurrent SMTP connections
# SMTP_RATE_LIMIT_PER_SECOND=2     # max messages started per second
# SMTP_CONNECTION_TIMEOUT_MS=10000 # must stay well under the worker lockDuration
# SMTP_GREETING_TIMEOUT_MS=10000
# SMTP_SOCKET_TIMEOUT_MS=60000
# SMTP_POOL_IDLE_MS=0              # 0 = never close the pool. close() is TERMINAL:
#                                  # nodemailer then drops sendMail callbacks and
#                                  # sends hang forever, so do not lower this.
# EMAIL_WORKER_CONCURRENCY=1       # recipient jobs processed at once
# EMAIL_QUEUE_ATTEMPTS=5           # retry attempts per recipient job
# EMAIL_QUEUE_BACKOFF_MS=5000      # base delay for the exponential retry backoff
# NOTIFICATION_OBSERVE_BUDGET_MS=4000  # how long the send endpoint waits inline
#                                      # before handing off to the queue

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=your-cloud-name
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your-upload-preset
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# --- AI APIs ---
GEMINI_API_KEY=your-gemini-api-key

# --- Groq (V4 chat brain — default OFF, V3 rule engine stays authoritative) ---
GROQ_CHAT_ENABLED=false
GROQ_API_KEY=your-groq-api-key
GROQ_CHAT_MODEL=llama-3.3-70b-versatile
GROQ_ANALYZE_MODEL=llama-3.3-70b-versatile
# Shadow mode: classify low-confidence messages via Groq but do NOT act on the
# result — log AiUsageLog rows only (used to measure NLU accuracy pre-cutover).
GROQ_NLU_SHADOW=false
# Cost tracking for AiUsageLog (USD per 1K tokens, llama-3.3-70b on Groq).
GROQ_COST_PER_1K_PROMPT=0.00059
GROQ_COST_PER_1K_COMPLETION=0.00079

# --- Redis ---
REDIS_URI=redis://default:<password>@<host>:<port>

# --- Resend ---
RESEND=re_your-resend-api-key

# --- Admin Panel ---
ADMIN_USER=admin@example.com
ADMIN_PASS=your-strong-admin-password
ADMIN_JWT_SECRET=your-admin-jwt-secret
SUPER_ADMIN_USER=superadmin@example.com
SUPER_ADMIN_PASS=your-strong-super-admin-password
ADMIN_RATE_LIMIT_MAX=5
ADMIN_RATE_LIMIT_WINDOW_MS=60000
ADMIN_LOGIN_ALERT_THRESHOLD=5
ADMIN_LOGIN_ALERT_WINDOW_MS=900000

# --- Internal API ---
INTERNAL_API_SECRET=change-me-to-a-random-secret

# --- Cron / Maintenance Worker ---
# Guard for /api/cron/* routes (budget-alerts, maintenance). The Render Cron
# Job sends `Authorization: Bearer $CRON_SECRET` hourly. Leave unset ONLY in
# local dev — in production an unset secret means the route is unauthenticated.
CRON_SECRET=8caba7a4fb25a5bbf01182577653cbb2ad2c9537404c5be71218f87f3ad3133a
# MongoDB storage cap used by the 50% / 75% size alerts (free tier = 512MB).
DB_SIZE_LIMIT_MB=512
# Anonymous marketing pageviews older than this are pruned hourly.
SITE_ANALYTICS_RETENTION_DAYS=180

# --- App Config ---
# NEXT_PUBLIC_SITE_URL and NEXT_PUBLIC_APP_URL are the ONLY variables that
# should decide a user-facing absolute URL. Both are resolved centrally in
# lib/site-url.ts; no other module builds a first-party absolute URL by hand.
#
#   SITE_ORIGIN  (NEXT_PUBLIC_SITE_URL)      public, indexable marketing site.
#                                             Canonical tags, Open Graph URLs,
#                                             JSON-LD, sitemap.xml, robots.txt
#                                             and llms.txt all use this.
#   APP_ORIGIN   (NEXT_PUBLIC_APP_URL)       origin serving authenticated routes
#                                             (/dashboard, /settings, /feedback,
#                                             /groups/invite/*). Must be the
#                                             Google-OAuth-registered origin.
NEXT_PUBLIC_SITE_URL=https://thespendwise.vercel.app
NEXT_PUBLIC_APP_URL=https://money-spend-tracker.vercel.app
# Legacy alias, honoured only as a fallback for SITE_ORIGIN. Do NOT set it
# alongside NEXT_PUBLIC_SITE_URL — the two would need to agree forever.
# NEXT_PUBLIC_PRODUCTION_LINK=https://thespendwise.vercel.app
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com
# Optional public phone for /contact UI + ContactPoint schema.
# When unset, phone is omitted from the page and structured data.
NEXT_PUBLIC_SUPPORT_PHONE=
NEXT_PUBLIC_GA_ID=G-MEASUREMENT_ID
EMAIL=support@example.com
PHONE=+1-234-567-8900
GITHUB=https://github.com/your-org/your-repo
LINKEDIN=https://linkedin.com/in/your-profile
REPO_NAME=expense-tracker
PROJECT_NAME=projects/your-project-id
PROJECT_NUMBER=your-project-number

# --- Multi-origin topology ---
# This app is deployed to several origins from one codebase/database:
#   https://thespendwise.vercel.app                        -> marketing site
#   https://money-spend-tracker.vercel.app                 -> PRIMARY app origin:
#                                                             the only origin registered in Google
#                                                             OAuth console; all sign-ins happen here
#   https://expense-tracker-black-nine-57.vercel.app       -> secondary app instance
# Sign-ins started on any other origin redirect to the primary, then bridge back.
# IMPORTANT: every deployment must share the same NEXTAUTH_SECRET and DATABASE_URL,
# and set its own NEXTAUTH_URL to its own domain.
#
# NEXT_PUBLIC_APP_ORIGIN / NEXT_PUBLIC_MARKETING_ORIGIN are the fallback for
# APP_ORIGIN / SITE_ORIGIN in lib/site-url.ts, and also feed the CORS + CSRF
# allowlist in lib/origins.ts. If the *_URL vars above are set (they are, and
# they should be), these are only load-bearing for the allowlist. Either way,
# point them at the same hosts the *_URL vars use — if the allowlist and the
# links disagree, one of the two is wrong.
NEXT_PUBLIC_APP_ORIGIN=https://money-spend-tracker.vercel.app
NEXT_PUBLIC_MARKETING_ORIGIN=https://thespendwise.vercel.app
# Comma-separated extra origins allowed for CORS/CSRF (defaults already include
# the three origins above and http://localhost:3000):
NEXT_PUBLIC_EXTRA_ALLOWED_ORIGINS=

# --- Rate Limiting ---
CHAT_RATE_LIMIT_MAX=20
CHAT_RATE_LIMIT_WINDOW_MS=60000
